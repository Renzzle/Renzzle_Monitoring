      "title": "기능별 사용량",
      "description": "기능별 호출 수.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (feature) (count_over_time({job=\"renzzle-backend\"} |= \"RequestLoggingFilter - \" |= \"[user=${user}]\" != \"[user=]\" | pattern `<_> [<_>] [<_>] [user=<_>] <_> - <method> <_> status=<_> <_>ms<_>` | pattern `<_> route=<route>` | label_format feature=`{{.method}} {{.route}}` [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "POST /api/auth/email": {
                  "text": "[인증] 가입 인증메일 발송",
                  "index": 0
                },
                "POST /api/auth/confirmCode": {
                  "text": "[인증] 인증코드 확인",
                  "index": 1
                },
                "GET /api/auth/duplicate/{nickname}": {
                  "text": "[인증] 닉네임 중복 확인",
                  "index": 2
                },
                "POST /api/auth/signup": {
                  "text": "[인증] 회원가입",
                  "index": 3
                },
                "POST /api/auth/login": {
                  "text": "[인증] 로그인",
                  "index": 4
                },
