                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "시각"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
